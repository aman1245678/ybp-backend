PORT=5041
NODE_ENV=development

# PostgreSQL — create DB "ybp", then set your password
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ybp?schema=public"

# CORS (comma-separated). Include Angular + Android emulator hosts as needed.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:4201,http://127.0.0.1:4201,http://10.0.2.2:5041

# JWT (change in production)
JWT_ACCESS_SECRET=ybp-dev-access-secret-change-me
JWT_REFRESH_SECRET=ybp-dev-refresh-secret-change-me
JWT_ACCESS_TTL=7d
JWT_REFRESH_TTL_DAYS=30

# Email confirmation
# Provider: smtp (Gmail) or resend (recommended — verify ybproductions.co.in on resend.com)
EMAIL_PROVIDER=smtp
EMAIL_ENABLED=false
EMAIL_FROM="Yashvi Bagga Productions <noreply@ybproductions.local>"
EMAIL_REPLY_TO=
SITE_URL=https://ybproductions.co.in
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Ops inbox — copy of every new application (optional)
OPS_NOTIFY_EMAIL=

# SMS (console stub until MSG91/Twilio)
SMS_ENABLED=false
SMS_PROVIDER=console

# OTP (email/mobile verification)
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_RESEND_ATTEMPTS=3
OTP_COOLDOWN_SECONDS=60
OTP_AUTH_GRACE_SECONDS=900
# Require email OTP before register/login (auto true in production)
AUTH_OTP_REQUIRED=false

# Admin panel login (seed creates/updates this user with Admin role)
ADMIN_EMAIL=admin@ybproductions.local
ADMIN_PASSWORD=Admin@12345
